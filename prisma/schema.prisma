generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  price      Int
  unit       String      @default("kg")
  image      String?
  inStock    Boolean     @default(true)
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id])
  items      OrderItem[]
  updatedAt  DateTime    @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())
  code          String      @unique @default(cuid())
  customerName  String
  phone         String
  address       String
  note          String?
  subtotal      Int
  deliveryFee   Int
  total         Int
  paymentMethod String      @default("COD")
  txnId         String?
  status        String      @default("NEW")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

// Order ke waqt ka naam aur price yahan save hota hai,
// taake rate badalne se purane orders na badlein.
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  qty       Float
  price     Int
}
